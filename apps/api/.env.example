DATABASE_URL="postgresql://ghepgo:ghepgo@localhost:5434/ghepgo?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
REDIS_URL="redis://localhost:6379"

# Map provider: osm (keyless dev default: Nominatim + public OSRM) | goong
GEO_PROVIDER="osm"
GOONG_API_KEY=""
# Platform commission on every fare (0.2 = 20%)
COMMISSION_RATE=0.2
# HMAC secret for payment-gateway callbacks (mock gateway in dev)
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
WEB_URL="http://localhost:3000"
