DATABASE_URL="postgresql://ghepgo:ghepgo@localhost:5434/ghepgo?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
REDIS_URL="redis://localhost:6379"

# Map provider: osm (keyless dev default: Nominatim + public OSRM) | goong
GEO_PROVIDER="osm"
GOONG_API_KEY=""
# Platform commission on every fare (0.2 = 20%)
COMMISSION_RATE=0.2
# Default payment gateway: vnpay | momo | mock. Every gateway with credentials is offered to the customer;
# mock (clickable dev checkout) is only available outside production.
PAYMENT_GATEWAY="vnpay"
# MoMo test environment — public sandbox credentials from https://developers.momo.vn/v3/docs/payment/onboarding/test-instructions
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn"
# VNPay sandbox merchant credentials — register at https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_EXPIRE_MINUTES=15
# Public URL of this API for gateway IPNs: VNPay <API_PUBLIC_URL>/api/wallet/vnpay/ipn (set in merchant portal),
# MoMo <API_PUBLIC_URL>/api/wallet/momo/ipn (sent per request);
# for local dev expose the API with ngrok/cloudflared)
API_PUBLIC_URL="http://localhost:3001"
# HMAC secret for the mock gateway callback (dev only)
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
# Web origin used to build the VNPay Return URL (<WEB_URL>/wallet/vnpay-return)
WEB_URL="http://localhost:3000"

# OTP on register / password reset. false = skip (dev only)
OTP_REQUIRED=true
# SMS provider: console (logs the code; API echoes it as devCode outside production) | esms | twilio
SMS_PROVIDER="console"
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
ESMS_BRANDNAME="GhepGo"
ESMS_SMS_TYPE=2
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Push notifications
# Web Push (VAPID): generate once with `npx web-push generate-vapid-keys`; web push is disabled until set
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@ghepgo.vn"
# Expo push: optional access token (Expo dashboard → Access tokens) for enhanced security
EXPO_ACCESS_TOKEN=""

# Service-area enforcement: pickup (default: pickup must be inside an active zone) | both | off.
# Skipped automatically while no active zone exists.
ZONE_ENFORCEMENT="pickup"
